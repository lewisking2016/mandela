# MANDELA backend — copy to backend/.env and fill in.

# --- Database (VPS: postgres:16 from docker-compose; dev: embedded-postgres) ---
# Empty host/port => the API uses the embedded dev Postgres (no Docker needed).
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=mandela
POSTGRES_PASSWORD=mandela_dev_pw
POSTGRES_CONTROL_DB=mandela_control

# Dev-only embedded postgres data dir (git-ignored)
DEV_PG_DATA=.devpg
# Override the embedded Postgres port if 54329 is taken:
# DEV_PG_PORT=54330

# --- Object storage (MinIO) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=mandela
MINIO_PASSWORD=mandela_dev_pw

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Provisioner ---
# Master key for AES-256-GCM credential vault (64 hex chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_MASTER_KEY=
# Public root for school subdomains (dev: localtest.me resolves to 127.0.0.1)
SCHOOL_HOST_ROOT=mandela.school

# --- API ---
PORT=4000
NODE_ENV=development

# --- Web module ---
# HMAC secret for web session cookies (change in production):
WEB_SESSION_SECRET=mandela_dev_web_secret_change_me
# Fallback tenant when the request host has no school subdomain:
WEB_DEFAULT_TENANT=demo
# CORS origin(s) for the Next.js app, comma-separated:
WEB_ORIGIN=http://localhost:3000
